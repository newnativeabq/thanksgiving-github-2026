{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recipe import v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "title", "course", "base_servings", "prep_minutes",
    "cook_minutes", "dietary_tags", "allergens", "ingredients", "steps"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S" },
    "course": {
      "enum": ["appetizer", "salad", "side", "main", "dessert", "sauce", "drink", "other"]
    },
    "base_servings": { "type": "integer", "minimum": 1, "maximum": 100 },
    "prep_minutes": { "type": "integer", "minimum": 0, "maximum": 10080 },
    "cook_minutes": { "type": "integer", "minimum": 0, "maximum": 10080 },
    "dietary_tags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["vegan", "vegetarian", "gluten_free", "dairy_free"] }
    },
    "allergens": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["milk", "egg", "fish", "crustacean_shellfish", "tree_nuts", "peanuts", "wheat", "soy", "sesame"]
      }
    },
    "notes": { "type": "string", "maxLength": 800 },
    "allergen_notes": { "type": "string", "maxLength": 400 },
    "make_ahead": { "type": "string", "maxLength": 800 },
    "equipment": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S" }
    },
    "source_url": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 400 },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": { "$ref": "#/$defs/ingredient" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": { "type": "string", "minLength": 1, "maxLength": 600, "pattern": "\\S" }
    }
  },
  "$defs": {
    "ingredient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "grocery_key", "amount", "unit", "aisle"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 140, "pattern": "\\S" },
        "grocery_key": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "amount": {
          "anyOf": [
            { "type": "number", "exclusiveMinimum": 0, "maximum": 100000 },
            { "type": "null" }
          ]
        },
        "unit": {
          "enum": [
            "tsp", "tbsp", "cup", "ml", "l", "fl_oz", "g", "kg", "oz", "lb", "each", "head",
            "clove", "pack", "sheet", "bulb", "stalk", "loaf", "can", "bunch", "pinch", "to_taste"
          ]
        },
        "aisle": {
          "enum": ["produce", "proteins", "refrigerated", "bakery", "pantry", "spices", "other"]
        },
        "prep_note": { "type": "string", "maxLength": 240 }
      },
      "allOf": [
        {
          "if": { "properties": { "unit": { "const": "to_taste" } } },
          "then": { "properties": { "amount": { "type": "null" } } },
          "else": { "properties": { "amount": { "type": "number" } } }
        }
      ]
    }
  },
  "examples": [
    {
      "schema_version": 1,
      "title": "Lemon and olive oil dressing",
      "course": "sauce",
      "base_servings": 6,
      "prep_minutes": 5,
      "cook_minutes": 0,
      "dietary_tags": ["vegan", "gluten_free"],
      "allergens": [],
      "notes": "Whisk just before serving.",
      "ingredients": [
        { "name": "Extra-virgin olive oil", "grocery_key": "olive-oil", "amount": 3, "unit": "tbsp", "aisle": "pantry" },
        { "name": "Fresh lemon juice", "grocery_key": "lemon-juice", "amount": 1, "unit": "tbsp", "aisle": "produce" },
        { "name": "Fine sea salt", "grocery_key": "fine-sea-salt", "amount": null, "unit": "to_taste", "aisle": "spices" }
      ],
      "steps": [
        "Whisk the olive oil and lemon juice until combined.",
        "Season with salt to taste."
      ]
    }
  ]
}
